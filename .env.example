# ---------------------------------------------------------------------------
# ThermoRivet environment configuration
#
# Copy to `.env` and fill in. NOTHING in this file is ever read from client
# components — every key here is server-only. The only values exposed to the
# browser are the ones prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL 15+ with the `vector` extension available) --------
DATABASE_URL="postgresql://thermorivet:thermorivet@localhost:5432/thermorivet?schema=public"

# --- Session/auth ----------------------------------------------------------
# 32+ random bytes, base64 or hex. Generate: openssl rand -base64 48
AUTH_SECRET=""
# Cookie lifetime in seconds (default 30 days)
SESSION_TTL_SECONDS="2592000"

# --- LLM provider ----------------------------------------------------------
# The diagnostic engine is deterministic; the LLM is used for language
# understanding, narration, and vision. See src/lib/ai/provider.ts.
ANTHROPIC_API_KEY=""
THERMORIVET_MODEL_REASONING="claude-fable-5"
THERMORIVET_MODEL_FAST="claude-haiku-4-5-20251001"
THERMORIVET_MODEL_VISION="claude-fable-5"

# --- Embeddings for the knowledge base (RAG) -------------------------------
# `local` uses the built-in deterministic hashing embedder (no network, good
# for dev/tests). `voyage` uses Voyage AI. See src/lib/rag/embeddings.ts.
EMBEDDING_PROVIDER="local"
VOYAGE_API_KEY=""
EMBEDDING_DIMENSIONS="1024"

# --- Speech to text --------------------------------------------------------
# `browser` uses the Web Speech API on-device (no key needed, default).
# `deepgram` posts audio to Deepgram from the server.
SPEECH_PROVIDER="browser"
DEEPGRAM_API_KEY=""

# --- Object storage (S3-compatible: AWS S3, R2, MinIO) ----------------------
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="thermorivet-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
# When unset, uploads fall back to local disk under ./.storage (dev only).
STORAGE_DRIVER="local"

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ThermoRivet"
# Comma-separated emails that are granted PLATFORM_ADMIN on first sign-up.
BOOTSTRAP_ADMIN_EMAILS=""

# --- Legal / support (required before App Store submission) ----------------
# The legal pages name a real operator and contact. Unset, they render a
# visible "[not configured]" rather than inventing one.
NEXT_PUBLIC_OPERATOR_NAME=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_OPERATOR_ADDRESS=""

# --- Apple In-App Purchase (iOS only) --------------------------------------
# Guideline 3.1.1: a subscription sold inside the iOS app must go through IAP.
# Stripe stays for the web; these drive the iOS path.
#
# APPLE_ROOT_CA_G3_B64 is the base64 of "Apple Root CA - G3" (.cer, DER) from
# https://www.apple.com/certificateauthority/ — receipts are verified against
# it. Without it, receipt verification refuses rather than trusting the client:
#   base64 -w0 AppleRootCA-G3.cer
APPLE_BUNDLE_ID=""
APPLE_ROOT_CA_G3_B64=""
APPLE_PRODUCT_PRO_MONTHLY=""
APPLE_PRODUCT_PRO_YEARLY=""
APPLE_PRODUCT_COMPANY_MONTHLY=""
APPLE_PRODUCT_COMPANY_YEARLY=""
# The same product ids, exposed to the client so the purchase sheet can open.
# Product ids are not secrets.
NEXT_PUBLIC_APPLE_PRODUCT_PRO_MONTHLY=""
NEXT_PUBLIC_APPLE_PRODUCT_COMPANY_MONTHLY=""

# --- iOS shell -------------------------------------------------------------
# The https origin the Capacitor shell loads. Required by `npx cap sync ios`.
CAPACITOR_SERVER_URL=""
